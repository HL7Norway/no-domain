       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Domain profile for Norwegian Vital Signs Observation Body Weight information. To be used for recording the actual measurement of body weight, including when the individual is missing a body part due to a congenital cause or after surgical removal." ] ;
