       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Domain profile for Norwegian Vital Signs Observation Oxygen Saturation information.  \nTo be used for recording blood oxygen and related measurements, measured by pulse oximetry or pulse CO-oximetry." ] ;
