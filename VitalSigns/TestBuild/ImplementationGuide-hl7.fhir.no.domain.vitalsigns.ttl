       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Domain profile for Norwegian Vital Signs Observation Respiration Rate information.  \nTo be used for recording the observed and measured characteristics of spontaneous breathing by an individual, including respiratory rate, depth and rhythm." ] ;
