# - resource -------------------------------------------------------------------

<http://hl7.no/fhir/no-domain/vitalsigns/Parameters/expansion> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "expansion"] ;
  fhir:Parameters.parameter [
     fhir:index 0 ;
     fhir:Parameters.parameter.name [ fhir:value "system-version" ] ;
     fhir:Parameters.parameter.valueUri [ fhir:value "http://snomed.info/sct|http://snomed.info/sct/51000202101" ]
  ] .

# - ontology header ------------------------------------------------------------

<http://hl7.no/fhir/no-domain/vitalsigns/Parameters/expansion.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

